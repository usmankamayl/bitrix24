# Пример конфигурации для интеграций
# Скопируйте этот файл в .env и заполните реальными значениями
# ВАЖНО: файл .env не должен попадать в Git!

# Внешняя система для B2B-заявок
EXTERNAL_API_URL=https://api.external-system.com
EXTERNAL_API_KEY=your_secret_api_key_here

# Для тестов можно использовать httpbin.org
# EXTERNAL_API_URL=https://httpbin.org
# EXTERNAL_API_KEY=test_key
